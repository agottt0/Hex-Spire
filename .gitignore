# ─────────────────────────────────────────────────────────────
# Godot 4
# ─────────────────────────────────────────────────────────────
# 引擎生成的导入缓存与类注册表，可完全重建（rm -rf .godot 后重新导入）
.godot/
/android/
*.translation

# ⚠️ 不要忽略 *.uid —— Godot 4 用它做资源标识，缺失会导致引用断裂
# ⚠️ 不要忽略 *.import —— 它记录导入参数，缺失会让美术资源重新导入成默认设置

# ─────────────────────────────────────────────────────────────
# 导出产物
# ─────────────────────────────────────────────────────────────
build/
export/
exports/
*.exe
*.pck
*.zip
*.apk
*.aab
*.dmg
*.app

# ─────────────────────────────────────────────────────────────
# 编辑器 / 系统
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─────────────────────────────────────────────────────────────
# 美术源文件（体积大，见 docs/01_美术高概念.md §13.4）
# 源文件放 Art/source/ 或项目外，仓库只存导出的 PNG
# ─────────────────────────────────────────────────────────────
Art/source/
*.psd
*.psb
*.ai
*.xcf
*.blend
*.blend1
*.aseprite
*.kra

# ─────────────────────────────────────────────────────────────
# 开发期中间产物
# ─────────────────────────────────────────────────────────────
# PPTX 渲染检查（tools/build_art_ppt.py 的中间图）
.pptcheck/
# battle_sim 的 JSON 报告
*.sim.json
sim_report*.json
# 截图（--shot 参数产出，落在 user:// 而非仓库，此处兜底）
battle_shot*.png

# ─────────────────────────────────────────────────────────────
# Claude Code 工作区
# ─────────────────────────────────────────────────────────────
.claude/worktrees/
.claude/settings.local.json
